{
  "name": "nanoclaw",
  "version": "1.1.0",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run rust:build",
    "start": "./scripts/run-rust-daemon.sh",
    "dev": "cd rust && cargo run -p nanoclawd -- --daemon --ipc-dir ../data/ipc/main --assistant-name ${ASSISTANT_NAME:-Andy} --poll-ms 500",
    "test": "npm run rust:test",
    "setup": "mkdir -p data/ipc/main/messages data/ipc/main/output data/ipc/main/processed",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "auth": "tsx src/whatsapp-auth.ts",
    "test:watch": "vitest",
    "rust:build": "cd rust && cargo build --release",
    "rust:test": "cd rust && cargo test",
    "rust:start": "cd rust && cargo run -p nanoclawd -- --daemon --ipc-dir ../data/ipc/main --assistant-name ${ASSISTANT_NAME:-Andy}",
    "rust:parse-output": "cd rust && cargo run -p nanoclawd -- --parse-container-output --input /tmp/container-stdout.log --output /tmp/container-parsed.tsv",
    "node:build": "tsc",
    "node:start": "node dist/index.js",
    "node:dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.5.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
